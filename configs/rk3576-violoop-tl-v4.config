# Select the independent Violoop RK3576 board target rather than inheriting
# Rockchip's RK3576 EVB board implementation.
# CONFIG_TARGET_EVB_RK3576 is not set
CONFIG_TARGET_VIOLOOP_RK3576_TL_V4=y
CONFIG_DEFAULT_DEVICE_TREE="rk3576-violoop-tl-v4"
CONFIG_OF_LIST="rk3576-violoop-tl-v4"
CONFIG_OF_BOARD_SETUP=y

# make.sh 用它解析基线：`./make.sh rk3576-violoop-tl-v4` 会展开成
#   make rk3576_defconfig rk3576-violoop-tl-v4.config
# 上游 violoop_sdk 没有这行，因为 ODM 走 device-rockchip 的构建框架
# （RK_UBOOT_CFG="rk3576" + RK_UBOOT_CFG_FRAGMENTS="rk3576-violoop-tl-v4"，
#   由框架分两步喂给 make）。我们的 bsp 直接调 ./make.sh <target>，
# 必须让片段自带基线，否则 BASE_DEFCONFIG 为空、make 拿不到起点。
# 与 configs/rk3576-secure.config 的做法一致。
CONFIG_BASE_DEFCONFIG="rk3576_defconfig"
